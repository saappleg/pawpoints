{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "petcare-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petcare-notifications",
      "database_id": "7d98a8c2-e224-4b24-bb19-e80fa6d40ad4"
    }
  ]
}
