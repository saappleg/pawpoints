name = "petcare-notifications"
main = "src/index.js"
compatibility_date = "2026-08-10"

# One scheduled scan handles manually entered booking reminders. Cron runs in UTC.
[triggers]
crons = ["*/5 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "petcare-notifications"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
