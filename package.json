{
  "name": "petcarebysteven",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./input.css -o ./assets/styles.v5.min.css --minify",
    "build:js": "esbuild ./src/app.js --bundle --minify --target=es2020 --outfile=./assets/app.v3.min.js",
    "watch": "tailwindcss -i ./input.css -o ./assets/styles.v5.min.css --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "firebase": "12.17.1",
    "tailwindcss": "^3.4.0"
  }
}
