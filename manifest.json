{
  "id": "pet-care-by-steven-app",
  "name": "Pet Care by Steven",
  "short_name": "Pet Care",
  "description": "Loyalty Program and Pet Care Portal for Pet Care by Steven",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone"
  ],
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "business",
    "lifestyle",
    "pets"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.petcarebysteven.app",
      "url": "https://play.google.com/store/apps/details?id=com.petcarebysteven.app"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://petcarebysteven.me"
    }
  ],
  "iarc_rating_id": "00000000-0000-0000-0000-000000000000",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+petcare",
      "url": "/?protocol=%s"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Paw Points Status",
      "short_name": "Paw Points",
      "description": "Quick view of your loyalty points",
      "tag": "paw-points-widget",
      "ms_ac_template": "/widgets/paw-points.json",
      "data": "/widgets/paw-points-data.json",
      "type": "application/json"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/new-note"
  },
  "shortcuts": [
    {
      "name": "View Paw Points",
      "short_name": "Paw Points",
      "description": "Check your loyalty rewards",
      "url": "/",
      "icons": [
        {
          "src": "/android-chrome-192x192.webp",
          "sizes": "192x192",
          "type": "image/webp"
        }
      ]
    },
    {
      "name": "Book Service",
      "short_name": "Book",
      "description": "Book a pet care service",
      "url": "/",
      "icons": [
        {
          "src": "/android-chrome-192x192.webp",
          "sizes": "192x192",
          "type": "image/webp"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "1344x2992",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1918x1080",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "icons": [
    {
      "src": "/android-chrome-192x192.webp",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "any maskable"
    },
    {
      "src": "/android-chrome-512x512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.webp",
      "sizes": "180x180",
      "type": "image/webp"
    },
    {
      "src": "/favicon-32x32.webp",
      "sizes": "32x32",
      "type": "image/webp"
    },
    {
      "src": "/favicon-16x16.webp",
      "sizes": "16x16",
      "type": "image/webp"
    }
  ]
}
