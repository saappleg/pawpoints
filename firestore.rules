rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function ownsClient(userId) { return signedIn() && request.auth.uid == userId; }
    function updatesOnlyClientProfile() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'email', 'phone', 'address', 'pets', 'homeEntryNotes',
        'lockboxCode', 'alarmInstructions', 'emergencyContacts', 'vetClinic',
        'vetPhone', 'vetAuth', 'houseChecklist', 'fcmToken', 'referralCode',
        'savedTrailIds', 'firstVisitChecklist', 'photoUrl'
      ]);
    }
    function validCoupon(title) {
      let coupons = request.resource.data.coupons;
      let coupon = coupons[coupons.size() - 1];
      return coupons.size() == resource.data.coupons.size() + 1
        && coupon.title == title && coupon.used == false
        && coupon.code.matches('PAW-[A-Z0-9]{8}');
    }
    function isValidClientRewardClaim() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'coupons']) && (
        (resource.data.points >= 5000 && request.resource.data.points == resource.data.points - 5000 && validCoupon('$10 Off Next Visit')) ||
        (resource.data.points >= 8000 && request.resource.data.points == resource.data.points - 8000 && validCoupon('$20 Off Next Visit'))
      );
    }
    function validTrailSubmission() {
      return request.resource.data.keys().hasOnly([
        'title', 'location', 'description', 'petFriendly', 'amenities', 'safety', 'bestTime', 'lat', 'lng', 'author', 'votes', 'upvoters', 'createdAt'
      ])
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.location is string && request.resource.data.location.size() >= 2 && request.resource.data.location.size() <= 180
        && request.resource.data.description is string && request.resource.data.description.size() >= 2 && request.resource.data.description.size() <= 2000
        && request.resource.data.petFriendly in ['Dog friendly', 'Dogs welcome on leash', 'Off-leash area available', 'Pet friendly with restrictions', 'All pets welcome']
        && request.resource.data.amenities is list && request.resource.data.amenities.size() <= 9
        && request.resource.data.safety is list && request.resource.data.safety.size() <= 4
        && request.resource.data.bestTime is string && request.resource.data.bestTime.size() <= 30
        && (request.resource.data.lat == null || (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
        && (request.resource.data.lng == null || (request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180))
        && request.resource.data.author is string && request.resource.data.author.size() <= 80
        && request.resource.data.votes == 0 && request.resource.data.upvoters.size() == 0
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{userId} {
      allow get: if ownsClient(userId);
      allow list, create, update, delete: if false;
    }
    match /clients/{userId} {
      allow get: if ownsClient(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if ownsClient(userId) && !request.resource.data.keys().hasAny(['isAdmin']);
      allow update: if isAdmin() || (ownsClient(userId) && (updatesOnlyClientProfile() || isValidClientRewardClaim()));
      allow delete: if isAdmin();
    }
    match /referral_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt']) && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /referral_claims/{clientUid} {
      allow get: if signedIn() && (request.auth.uid == clientUid || isAdmin());
      allow list, update, delete: if isAdmin();
      allow create: if signedIn() && request.auth.uid == clientUid
        && request.resource.data.keys().hasOnly(['referrerUid', 'clientUid', 'status', 'createdAt'])
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.status == 'pending';
    }
    match /community_guides/{guideId} {
      allow read: if true;
      allow create: if signedIn() && validTrailSubmission();
      allow update: if isAdmin() || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoters', 'votes']));
      allow delete: if isAdmin();
    }
    match /community_guides/{guideId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'message', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /trail_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['trailId', 'trailTitle', 'reason', 'details', 'reporterUid', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 100
        && request.resource.data.details is string && request.resource.data.details.size() <= 500;
      allow read, update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }
    match /gallery_photos/{photoId} { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{faqId} { allow read: if true; allow write: if isAdmin(); }
    match /broadcasts/{broadcastId} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{settingId} { allow read: if true; allow write: if isAdmin(); }
    match /search_logs/{logId} {
      allow create: if request.resource.data.keys().hasOnly(['query', 'covered', 'timestamp']);
      allow read, update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
